# Local template only. Never commit real keys or private .p8 files.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# DeepSeek report analysis and chat. Choose a model enabled in your account.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Optional web evidence; required for sourced market/competitor research.
TAVILY_API_KEY=
# Legacy chat fallback only (not required when DeepSeek is configured).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
QUOTA_FILE=./data/free-usage.json
APPLE_IAP_KEY_PATH=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_ROOT_CA_PATHS=
APPLE_ENVIRONMENTS=Production,Sandbox
# Enable only after real sandbox purchase/restore/expiry tests pass.
PRO_PURCHASES_ENABLED=false
RATE_LIMIT_REQUESTS=20
GLOBAL_RATE_LIMIT_REQUESTS=120

# Daily background research. Disabled until Apple/provider/storage smoke tests pass.
MONITORING_ENABLED=false
MONITORING_FILE=./data/market-monitors.json
# Global UTC-day attempted checks. One owner can run at most once per 24 hours.
MONITORING_DAILY_LIMIT=100
